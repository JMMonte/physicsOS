# Jupyter
.ipynb_checkpoints/

# Heavy/opaque outputs: regenerable and not human-readable in a report.
# NOTE: figures (*.png/*.pdf) are intentionally NOT ignored — they must be
# embedded in and committed with the audit/report so a human reading it on
# GitHub sees the plot without running the script.
audits/**/outputs/*.npy
audits/**/outputs/*.npz
audits/**/data/

